[run]
# Isso garante que o coverage saiba como lidar com o código do Django
plugins =
    django_coverage_plugin
# **MUITO IMPORTANTE:** Defina o diretório base do seu projeto.
# Substitua 'meu_projeto_app' pelo nome do seu diretório de código.
source =
    .

[report]
# Diretórios e arquivos a serem excluídos do relatório
omit =
    */tests/*
    */migrations/*
    */venv/*
    */settings/*
    */__init__.py
    manage.py

# Exclui linhas específicas
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.: